NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hisobx_db"
REDIS_URL="redis://localhost:6379"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
BASE_URL="http://localhost:3000"
FILE_PATH="uploads"

SUPERADMIN_PHONE="+998900000000"
SUPERADMIN_PASSWORD="SuperSecret123!"

JWT_ACCESS_SECRET="hisobx-super-secret-access-token-key-2026"
ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_SECRET="hisobx-super-secret-refresh-token-key-2026"
REFRESH_TOKEN_TTL="7d"
REFRESH_GRACE_SECONDS=30

# Qurilma sessiyalari (har bir foydalanuvchi uchun)
DEVICE_LIMIT_PER_USER=3
DEVICE_REMOVAL_MIN_AGE_HOURS=24

OTP_TTL_SECONDS=60
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_PENDING_WINDOW_SECONDS=600
OTP_SECRET="hisobx-otp-hash-secret"

# Telegram bot (OTP kodlar shu bot orqali yuboriladi)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# localhost uchun `polling`; boshqa qiymatda bot yangilanishlarni o'qimaydi
TELEGRAM_MODE="polling"
# Hisobni ulash tokeni amal qilish muddati (sekund)
TELEGRAM_LINK_TTL_SECONDS=600
# Bot tokeni yo'q bo'lsa, development'da kodni odatdagidek berish (localhost uchun).
# `false` — dev'da ham Telegramga ulash majburiy.
TELEGRAM_DEV_FALLBACK="true"

# Do'kon guruhiga xabar yuborish uchun (ixtiyoriy)
CHAT_ID=""


SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_FROM=""
SMTP_PASSWORD=""

# Rate limiting (Redis storage)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_USER_LIMIT=120
RATE_LIMIT_ANON_LIMIT=30
RATE_LIMIT_STRICT_TTL_SECONDS=60
RATE_LIMIT_STRICT_LIMIT=3

# Sign-in: ketma-ket xato parollar bloki
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Proxy ortida haqiqiy IP (0 = o'chirilgan)
TRUST_PROXY=1
