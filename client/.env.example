# API bazaviy manzili (dev'da Vite proxy orqali ketadi)
VITE_API_URL=/api/v1

# Dev proxy backend manzili (server/.env dagi PORT bilan mos bo'lsin)
VITE_PROXY_TARGET=http://localhost:3010

VITE_APP_NAME=HisobX

# true bo'lsa, backend'da hali yo'q endpoint'lar MSW mock'idan olinadi
VITE_USE_MOCKS=true

# true bo'lsa, kirish oqimi ham to'liq mock'lanadi (backendsiz sinash uchun).
# Sinov raqamlari: +998900000001 (Telegram ulanmagan), ...011 MANAGER,
# ...012 ADMIN, ...013 SELLER, ...014 SUPERADMIN. Kod: 111111
VITE_MOCK_AUTH=false

# Telegram bot manzili, masalan: https://t.me/hisobx_bot
